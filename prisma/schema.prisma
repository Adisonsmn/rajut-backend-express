// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================
// USER
// ==========================

model User {
  userId       Int      @id @default(autoincrement()) @map("user_id")
  role         String   @default("USER") @db.VarChar(20)
  fullName     String   @db.VarChar(150) @map("full_name")
  email        String   @unique @db.VarChar(150)
  phone        String?  @db.VarChar(20)
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  addresses              UserAddress[]
  customProductRequests  CustomProductRequest[]
  customProductResponses CustomProductResponse[] @relation("AdminResponses")
  carts                  Cart[]
  transactions           Transaction[]

  @@map("users")
}

// ==========================
// USER ADDRESS
// ==========================

model UserAddress {
  addressId    Int     @id @default(autoincrement()) @map("address_id")
  userId       Int     @map("user_id")
  receiverName String  @db.VarChar(150) @map("receiver_name")
  phone        String? @db.VarChar(20)
  address      String
  city         String? @db.VarChar(100)
  province     String? @db.VarChar(100)
  postalCode   String? @db.VarChar(10) @map("postal_code")
  isDefault    Boolean @default(false) @map("is_default")

  user         User          @relation(fields: [userId], references: [userId], onDelete: Cascade)
  transactions Transaction[]

  @@map("user_addresses")
}

// ==========================
// PRODUCT
// ==========================

model Product {
  productId   Int      @id @default(autoincrement()) @map("product_id")
  name        String   @db.VarChar(200)
  description String?
  basePrice   Decimal  @db.Decimal(12, 2) @map("base_price")
  imageUrl    String?  @map("image_url")
  createdAt   DateTime @default(now()) @map("created_at")

  variants ProductVariant[]

  @@map("products")
}

// ==========================
// PRODUCT VARIANT
// Contoh: Kaos Hitam L, Kaos Hitam XL, Kaos Putih L
// ==========================

model ProductVariant {
  variantId Int     @id @default(autoincrement()) @map("variant_id")
  productId Int     @map("product_id")
  color     String? @db.VarChar(50)
  size      String? @db.VarChar(20)
  stock     Int     @default(0)

  product          Product           @relation(fields: [productId], references: [productId], onDelete: Cascade)
  cartItems        CartItem[]
  transactionItems TransactionItem[]

  @@map("product_variants")
}

// ==========================
// CUSTOM PRODUCT REQUEST
// ==========================

model CustomProductRequest {
  requestId      Int      @id @default(autoincrement()) @map("request_id")
  userId         Int      @map("user_id")
  customName     String   @db.VarChar(200) @map("custom_name")
  description    String
  referenceImage String?  @map("reference_image")
  status         String   @default("Pending") @db.VarChar(30)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  user      User                   @relation(fields: [userId], references: [userId], onDelete: Cascade)
  responses CustomProductResponse[]

  @@map("custom_product_requests")
}

model CustomProductResponse {
  responseId            Int      @id @default(autoincrement()) @map("response_id")
  requestId             Int      @map("request_id")
  adminId               Int      @map("admin_id")
  responseMessage       String   @map("response_message")
  estimatedPrice        Decimal? @db.Decimal(12, 2) @map("estimated_price")
  estimatedFinishDate   DateTime? @db.Date @map("estimated_finish_date")
  statusAfterResponse   String?  @db.VarChar(30) @map("status_after_response")
  createdAt             DateTime @default(now()) @map("created_at")

  request CustomProductRequest @relation(fields: [requestId], references: [requestId], onDelete: Cascade)
  admin   User                 @relation("AdminResponses", fields: [adminId], references: [userId])

  @@map("custom_product_responses")
}

// ==========================
// PROMO
// ==========================

model Promo {
  promoId         Int      @id @default(autoincrement()) @map("promo_id")
  promoName       String   @db.VarChar(100) @map("promo_name")
  promoCode       String?  @unique @db.VarChar(30) @map("promo_code")
  discountPercent Decimal? @db.Decimal(5, 2) @map("discount_percent")
  discountAmount  Decimal? @db.Decimal(12, 2) @map("discount_amount")
  validUntil      DateTime? @db.Date @map("valid_until")

  carts        Cart[]
  transactions Transaction[]

  @@map("promos")
}

// ==========================
// CART
// ==========================

model Cart {
  cartId    Int      @id @default(autoincrement()) @map("cart_id")
  userId    Int      @map("user_id")
  promoId   Int?     @map("promo_id")
  createdAt DateTime @default(now()) @map("created_at")

  user      User       @relation(fields: [userId], references: [userId], onDelete: Cascade)
  promo     Promo?     @relation(fields: [promoId], references: [promoId])
  cartItems CartItem[]

  @@map("carts")
}

// ==========================
// CART ITEMS
// ==========================

model CartItem {
  cartItemId Int @id @default(autoincrement()) @map("cart_item_id")
  cartId     Int @map("cart_id")
  variantId  Int @map("variant_id")
  quantity   Int

  cart    Cart           @relation(fields: [cartId], references: [cartId], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [variantId])

  @@map("cart_items")
}

// ==========================
// TRANSACTION
// ==========================

model Transaction {
  transactionId   Int      @id @default(autoincrement()) @map("transaction_id")
  userId          Int      @map("user_id")
  promoId         Int?     @map("promo_id")
  addressId       Int?     @map("address_id")
  transactionDate DateTime @default(now()) @map("transaction_date")
  totalPrice      Decimal? @db.Decimal(12, 2) @map("total_price")
  status          String   @default("Pending") @db.VarChar(30)

  user             User              @relation(fields: [userId], references: [userId])
  promo            Promo?            @relation(fields: [promoId], references: [promoId])
  address          UserAddress?      @relation(fields: [addressId], references: [addressId])
  transactionItems TransactionItem[]

  @@map("transactions")
}

// ==========================
// TRANSACTION DETAIL
// ==========================

model TransactionItem {
  transactionItemId Int     @id @default(autoincrement()) @map("transaction_item_id")
  transactionId     Int     @map("transaction_id")
  variantId         Int     @map("variant_id")
  quantity          Int
  price             Decimal @db.Decimal(12, 2)

  transaction Transaction    @relation(fields: [transactionId], references: [transactionId], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [variantId])

  @@map("transaction_items")
}