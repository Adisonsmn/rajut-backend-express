generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["multiSchema", "partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

// ==========================
// USER (public.users)
// ==========================
model User {
  id              BigInt    @id @default(autoincrement())
  name            String    @db.VarChar(255)
  email           String    @unique(map: "users_email_unique") @db.VarChar(255)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamp(0)
  password        String?   @db.VarChar(255)
  rememberToken   String?   @map("remember_token") @db.VarChar(100)
  createdAt       DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime? @map("updated_at") @db.Timestamp(0)
  role            String    @default("customer") @db.VarChar(20)
  isActive        Boolean   @default(true) @map("is_active")
  phone           String?   @db.VarChar(30)
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(0)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(0)
  authUserId      String?   @unique @map("auth_user_id") @db.Uuid

  addresses           Address?
  carts               Cart?
  inventoryMovements  InventoryMovement[]
  orders              Order[]
  siteSettings        SiteSettings[]

  @@index([isActive], map: "users_is_active_index")
  @@index([role], map: "users_role_index")
  @@map("users")
  @@schema("public")
}

// ==========================
// CATEGORY (public.categories)
// ==========================
model Category {
  id              BigInt     @id @default(autoincrement())
  name            String     @unique(map: "categories_name_unique") @db.VarChar(255)
  slug            String     @unique(map: "categories_slug_unique") @db.VarChar(255)
  description     String?
  icon            String?    @db.VarChar(255)
  backgroundColor String?    @map("background_color") @db.VarChar(255)
  sortOrder       Int        @default(0) @map("sort_order")
  isActive        Boolean    @default(true) @map("is_active")
  createdAt       DateTime?  @map("created_at") @db.Timestamptz(0)
  updatedAt       DateTime?  @map("updated_at") @db.Timestamptz(0)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(0)

  products Product[]

  @@map("categories")
  @@schema("public")
}

// ==========================
// PRODUCT (public.products)
// ==========================
model Product {
  id               BigInt    @id @default(autoincrement())
  categoryId       BigInt    @map("category_id")
  name             String    @db.VarChar(255)
  slug             String    @unique(map: "products_slug_unique") @db.VarChar(255)
  shortDescription String?   @map("short_description") @db.VarChar(255)
  description      String
  price            Decimal   @db.Decimal(14, 2)
  stock            Int       @default(0)
  availabilityType String    @default("ready_stock") @map("availability_type") @db.VarChar(255)
  preorderDuration String?   @map("preorder_duration") @db.VarChar(255)
  isFeatured       Boolean   @default(false) @map("is_featured")
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime? @map("created_at") @db.Timestamptz(0)
  updatedAt        DateTime? @map("updated_at") @db.Timestamptz(0)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(0)

  category           Category           @relation(fields: [categoryId], references: [id], onUpdate: NoAction, map: "products_category_id_foreign")
  images             ProductImage?
  cartItems          CartItem[]
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]

  @@index([isActive, createdAt], map: "products_is_active_created_at_index")
  @@map("products")
  @@schema("public")
}

// ==========================
// PRODUCT IMAGE (public.product_images)
// ==========================
model ProductImage {
  id        BigInt    @id @default(autoincrement())
  productId BigInt    @unique(map: "product_images_one_primary", where: raw("(is_primary = true)")) @map("product_id")
  path      String    @db.VarChar(255)
  altText   String?   @map("alt_text") @db.VarChar(255)
  sortOrder Int       @default(0) @map("sort_order")
  isPrimary Boolean   @default(false) @map("is_primary")
  mimeType  String?   @map("mime_type") @db.VarChar(255)
  fileSize  BigInt?   @map("file_size")
  createdAt DateTime? @map("created_at") @db.Timestamptz(0)
  updatedAt DateTime? @map("updated_at") @db.Timestamptz(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "product_images_product_id_foreign")

  @@index([productId, sortOrder], map: "product_images_product_id_sort_order_index")
  @@map("product_images")
  @@schema("public")
}

// ==========================
// ADDRESS (public.addresses)
// ==========================
model Address {
  id            BigInt    @id @default(autoincrement())
  userId        BigInt    @unique(map: "addresses_one_default", where: raw("(is_default = true)")) @map("user_id")
  label         String?   @db.VarChar(255)
  recipientName String    @map("recipient_name") @db.VarChar(255)
  phone         String    @db.VarChar(255)
  province      String    @db.VarChar(255)
  city          String    @db.VarChar(255)
  district      String    @db.VarChar(255)
  postalCode    String    @map("postal_code") @db.VarChar(255)
  addressLine   String    @map("address_line")
  notes         String?
  latitude      Decimal?  @db.Decimal(10, 7)
  longitude     Decimal?  @db.Decimal(10, 7)
  isDefault     Boolean   @default(false) @map("is_default")
  createdAt     DateTime? @map("created_at") @db.Timestamptz(0)
  updatedAt     DateTime? @map("updated_at") @db.Timestamptz(0)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "addresses_user_id_foreign")
  orders Order[]

  @@map("addresses")
  @@schema("public")
}

// ==========================
// CART (public.carts)
// ==========================
model Cart {
  id         BigInt     @id @default(autoincrement())
  userId     BigInt?    @unique(map: "carts_one_active_per_user", where: raw("(((status)::text = 'active'::text) AND (user_id IS NOT NULL))")) @map("user_id")
  guestToken String?    @map("guest_token") @db.Uuid
  status     String     @default("active") @db.VarChar(255)
  expiresAt  DateTime?  @map("expires_at") @db.Timestamptz(0)
  createdAt  DateTime?  @map("created_at") @db.Timestamptz(0)
  updatedAt  DateTime?  @map("updated_at") @db.Timestamptz(0)

  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "carts_user_id_foreign")
  cartItems CartItem[]

  @@map("carts")
  @@schema("public")
}

// ==========================
// CART ITEM (public.cart_items)
// ==========================
model CartItem {
  id        BigInt    @id @default(autoincrement())
  cartId    BigInt    @map("cart_id")
  productId BigInt    @map("product_id")
  quantity  Int
  createdAt DateTime? @map("created_at") @db.Timestamptz(0)
  updatedAt DateTime? @map("updated_at") @db.Timestamptz(0)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "cart_items_cart_id_foreign")
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "cart_items_product_id_foreign")

  @@unique([cartId, productId], map: "cart_items_cart_id_product_id_unique")
  @@map("cart_items")
  @@schema("public")
}

// ==========================
// ORDER (public.orders)
// ==========================
model Order {
  id              BigInt    @id @default(autoincrement())
  orderNumber     String    @unique(map: "orders_order_number_unique") @map("order_number") @db.VarChar(255)
  userId          BigInt?   @map("user_id")
  addressId       BigInt?   @map("address_id")
  customerName    String    @map("customer_name") @db.VarChar(255)
  customerEmail   String    @map("customer_email") @db.VarChar(255)
  customerPhone   String    @map("customer_phone") @db.VarChar(255)
  shippingAddress Json      @map("shipping_address")
  status          String    @default("pending") @db.VarChar(255)
  subtotal        Decimal   @default(0) @db.Decimal(14, 2)
  shippingCost    Decimal   @default(0) @map("shipping_cost") @db.Decimal(14, 2)
  discountAmount  Decimal   @default(0) @map("discount_amount") @db.Decimal(14, 2)
  total           Decimal   @default(0) @db.Decimal(14, 2)
  customerNotes   String?   @map("customer_notes")
  adminNotes      String?   @map("admin_notes")
  placedAt        DateTime? @map("placed_at") @db.Timestamptz(0)
  paidAt          DateTime? @map("paid_at") @db.Timestamptz(0)
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(0)
  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamptz(0)
  createdAt       DateTime? @map("created_at") @db.Timestamptz(0)
  updatedAt       DateTime? @map("updated_at") @db.Timestamptz(0)

  address   Address?    @relation(fields: [addressId], references: [id], onUpdate: NoAction, map: "orders_address_id_foreign")
  user      User?       @relation(fields: [userId], references: [id], onUpdate: NoAction, map: "orders_user_id_foreign")
  items     OrderItem[]
  payments  Payment[]
  shipment  Shipment?

  @@map("orders")
  @@schema("public")
}

// ==========================
// ORDER ITEM (public.order_items)
// ==========================
model OrderItem {
  id               BigInt    @id @default(autoincrement())
  orderId          BigInt    @map("order_id")
  productId        BigInt?   @map("product_id")
  productName      String    @map("product_name") @db.VarChar(255)
  productSlug      String    @map("product_slug") @db.VarChar(255)
  productImage     String?   @map("product_image") @db.VarChar(255)
  price            Decimal   @db.Decimal(14, 2)
  quantity         Int
  subtotal         Decimal   @db.Decimal(14, 2)
  availabilityType String    @map("availability_type") @db.VarChar(255)
  preorderDuration String?   @map("preorder_duration") @db.VarChar(255)
  customization    Json?
  createdAt        DateTime? @map("created_at") @db.Timestamptz(0)
  updatedAt        DateTime? @map("updated_at") @db.Timestamptz(0)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "order_items_order_id_foreign")
  product Product? @relation(fields: [productId], references: [id], onUpdate: NoAction, map: "order_items_product_id_foreign")

  @@map("order_items")
  @@schema("public")
}

// ==========================
// PAYMENT (public.payments)
// ==========================
model Payment {
  id                BigInt    @id @default(autoincrement())
  orderId           BigInt    @map("order_id")
  provider          String?   @db.VarChar(255)
  method            String    @db.VarChar(255)
  externalReference String?   @map("external_reference") @db.VarChar(255)
  amount            Decimal   @db.Decimal(14, 2)
  status            String    @default("pending") @db.VarChar(255)
  paidAt            DateTime? @map("paid_at") @db.Timestamptz(0)
  payload           Json?
  createdAt         DateTime? @map("created_at") @db.Timestamptz(0)
  updatedAt         DateTime? @map("updated_at") @db.Timestamptz(0)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "payments_order_id_foreign")

  @@index([orderId, status], map: "payments_order_id_status_index")
  @@map("payments")
  @@schema("public")
}

// ==========================
// SHIPMENT (public.shipments)
// ==========================
model Shipment {
  id             BigInt    @id @default(autoincrement())
  orderId        BigInt    @unique(map: "shipments_order_id_unique") @map("order_id")
  courier        String?   @db.VarChar(255)
  service        String?   @db.VarChar(255)
  trackingNumber String?   @map("tracking_number") @db.VarChar(255)
  status         String    @default("pending") @db.VarChar(255)
  shippedAt      DateTime? @map("shipped_at") @db.Timestamptz(0)
  deliveredAt    DateTime? @map("delivered_at") @db.Timestamptz(0)
  createdAt      DateTime? @map("created_at") @db.Timestamptz(0)
  updatedAt      DateTime? @map("updated_at") @db.Timestamptz(0)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "shipments_order_id_foreign")

  @@map("shipments")
  @@schema("public")
}

// ==========================
// INVENTORY MOVEMENT (public.inventory_movements)
// ==========================
model InventoryMovement {
  id             BigInt   @id @default(autoincrement())
  productId      BigInt   @map("product_id")
  userId         BigInt?  @map("user_id")
  type           String   @db.VarChar(255)
  quantityChange Int      @map("quantity_change")
  stockBefore    Int      @map("stock_before")
  stockAfter     Int      @map("stock_after")
  referenceType  String?  @map("reference_type") @db.VarChar(255)
  referenceId    BigInt?  @map("reference_id")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "inventory_movements_product_id_foreign")
  user    User?   @relation(fields: [userId], references: [id], onUpdate: NoAction, map: "inventory_movements_user_id_foreign")

  @@map("inventory_movements")
  @@schema("public")
}

// ==========================
// SITE SETTINGS (public.site_settings)
// ==========================
model SiteSettings {
  id                   BigInt    @id @default(1)
  brandName            String    @map("brand_name") @db.VarChar(255)
  tagline              String?   @db.VarChar(255)
  logoPath             String?   @map("logo_path") @db.VarChar(255)
  heroBadge            String?   @map("hero_badge") @db.VarChar(255)
  heroHeading          String    @map("hero_heading") @db.VarChar(255)
  heroHighlight        String?   @map("hero_highlight") @db.VarChar(255)
  heroDescription      String    @map("hero_description")
  heroImagePath        String?   @map("hero_image_path") @db.VarChar(255)
  promotionTitle       String?   @map("promotion_title") @db.VarChar(255)
  promotionDescription String?   @map("promotion_description")
  instagramUrl         String?   @map("instagram_url") @db.VarChar(255)
  whatsappNumber       String?   @map("whatsapp_number") @db.VarChar(255)
  contactEmail         String?   @map("contact_email") @db.VarChar(255)
  footerText           String?   @map("footer_text")
  updatedBy            BigInt?   @map("updated_by")
  createdAt            DateTime? @map("created_at") @db.Timestamptz(0)
  updatedAt            DateTime? @map("updated_at") @db.Timestamptz(0)

  user User? @relation(fields: [updatedBy], references: [id], onUpdate: NoAction, map: "site_settings_updated_by_foreign")

  @@map("site_settings")
  @@schema("public")
}
