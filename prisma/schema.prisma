generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

model User {
  userId       String    @id @default(uuid()) @map("user_id") @db.Uuid
  role         String    @default("USER") @db.VarChar(20)
  fullName     String    @map("full_name") @db.VarChar(150)
  email        String    @unique @db.VarChar(150)
  phone        String?   @db.VarChar(20)
  passwordHash String    @map("password_hash")
  avatarUrl    String?   @map("avatar_url")
  createdAt    DateTime? @default(now()) @map("created_at")

  addresses              UserAddress[]
  customProductRequests  CustomProductRequest[]
  customProductResponses CustomProductResponse[]
  carts                  Cart[]
  transactions           Transaction[]

  @@map("users")
  @@schema("public")
}

model UserAddress {
  addressId    String    @id @default(uuid()) @map("address_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  receiverName String    @map("receiver_name") @db.VarChar(150)
  phone        String?   @db.VarChar(20)
  address      String
  city         String?   @db.VarChar(100)
  province     String?   @db.VarChar(100)
  postalCode   String?   @map("postal_code") @db.VarChar(10)
  isDefault    Boolean?  @default(false) @map("is_default")

  label        String?   @db.VarChar(50)
  district     String?   @db.VarChar(100)
  addressLine  String?   @map("address_line")
  notes        String?
  latitude     Decimal?  @db.Decimal(10,7)
  longitude    Decimal?  @db.Decimal(10,7)

  user         User          @relation(fields: [userId], references: [userId], onDelete: Cascade)
  transactions Transaction[]

  @@map("user_addresses")
  @@schema("public")
}

model Category {
  categoryId      String    @id @default(uuid()) @map("category_id") @db.Uuid
  name            String    @unique @db.VarChar(100)
  slug            String?   @unique @db.VarChar(100)
  description     String?
  icon            String?   @db.VarChar(50)
  backgroundColor String?   @map("background_color") @db.VarChar(30)
  sortOrder       Int?      @default(0) @map("sort_order")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime? @default(now()) @map("created_at")

  @@map("categories")
  @@schema("public")
}

model Product {
  productId   String    @id @default(uuid()) @map("product_id") @db.Uuid
  name        String    @db.VarChar(200)
  description String?
  basePrice   Decimal   @map("base_price") @db.Decimal(12,2)
  imageUrls   String[]  @map("image_urls")
  category    String?   @db.VarChar(100)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime? @default(now()) @map("created_at")

  variants    ProductVariant[]

  @@map("products")
  @@schema("public")
}

model ProductVariant {
  variantId String  @id @default(uuid()) @map("variant_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  color     String? @db.VarChar(50)
  size      String? @db.VarChar(20)
  stock     Int     @default(0)

  product           Product           @relation(fields: [productId], references: [productId], onDelete: Cascade)
  cartItems         CartItem[]
  transactionItems  TransactionItem[]

  @@map("product_variants")
  @@schema("public")
}

model CustomProductRequest {
  requestId       String    @id @default(uuid()) @map("request_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  customName      String    @map("custom_name") @db.VarChar(200)
  description     String
  referenceImages String[]  @map("reference_images")
  status          String    @default("Pending") @db.VarChar(30)
  createdAt       DateTime? @default(now()) @map("created_at")
  updatedAt       DateTime? @default(now()) @map("updated_at")

  user           User                    @relation(fields: [userId], references: [userId], onDelete: Cascade)
  responses      CustomProductResponse[]

  @@map("custom_product_requests")
  @@schema("public")
}

model CustomProductResponse {
  responseId          String    @id @default(uuid()) @map("response_id") @db.Uuid
  requestId           String    @map("request_id") @db.Uuid
  adminId             String    @map("admin_id") @db.Uuid
  responseMessage     String    @map("response_message")
  responseImages      String[]  @map("response_images")
  estimatedPrice      Decimal?  @map("estimated_price") @db.Decimal(12,2)
  estimatedFinishDate DateTime? @map("estimated_finish_date") @db.Date
  statusAfterResponse String?   @map("status_after_response") @db.VarChar(30)
  createdAt           DateTime? @default(now()) @map("created_at")

  request             CustomProductRequest @relation(fields: [requestId], references: [requestId], onDelete: Cascade)
  admin               User                 @relation(fields: [adminId], references: [userId])

  @@map("custom_product_responses")
  @@schema("public")
}

model Promo {
  promoId        String    @id @default(uuid()) @map("promo_id") @db.Uuid
  promoName      String    @map("promo_name") @db.VarChar(100)
  promoCode      String?   @unique @map("promo_code") @db.VarChar(30)
  discountPercent Decimal? @map("discount_percent") @db.Decimal(5,2)
  discountAmount Decimal?  @map("discount_amount") @db.Decimal(12,2)
  validUntil     DateTime? @map("valid_until") @db.Date

  carts          Cart[]
  transactions   Transaction[]

  @@map("promos")
  @@schema("public")
}

model Cart {
  cartId    String    @id @default(uuid()) @map("cart_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  promoId   String?   @map("promo_id") @db.Uuid
  createdAt DateTime? @default(now()) @map("created_at")

  user      User       @relation(fields: [userId], references: [userId], onDelete: Cascade)
  promo     Promo?     @relation(fields: [promoId], references: [promoId])
  cartItems CartItem[]

  @@map("carts")
  @@schema("public")
}

model CartItem {
  cartItemId String @id @default(uuid()) @map("cart_item_id") @db.Uuid
  cartId     String @map("cart_id") @db.Uuid
  variantId  String @map("variant_id") @db.Uuid
  quantity   Int

  cart       Cart           @relation(fields: [cartId], references: [cartId], onDelete: Cascade)
  variant    ProductVariant @relation(fields: [variantId], references: [variantId])

  @@map("cart_items")
  @@schema("public")
}

model Transaction {
  transactionId   String    @id @default(uuid()) @map("transaction_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  promoId         String?   @map("promo_id") @db.Uuid
  addressId       String?   @map("address_id") @db.Uuid
  transactionDate DateTime? @default(now()) @map("transaction_date")
  totalPrice      Decimal?  @map("total_price") @db.Decimal(12,2)
  status          String?   @default("Pending") @db.VarChar(30)

  orderNumber     String?   @unique @map("order_number") @db.VarChar(50)
  deliveryMethod  String?   @map("delivery_method") @db.VarChar(50)
  shippingCost    Decimal?  @map("shipping_cost") @db.Decimal(12,2)
  notes           String?
  paidAmount      Decimal?  @map("paid_amount") @db.Decimal(12,2)

  user            User              @relation(fields: [userId], references: [userId])
  promo           Promo?            @relation(fields: [promoId], references: [promoId])
  address         UserAddress?      @relation(fields: [addressId], references: [addressId])
  items           TransactionItem[]
  payments        Payment[]

  @@map("transactions")
  @@schema("public")
}

model TransactionItem {
  transactionItemId String  @id @default(uuid()) @map("transaction_item_id") @db.Uuid
  transactionId     String  @map("transaction_id") @db.Uuid
  variantId         String  @map("variant_id") @db.Uuid
  quantity          Int
  price             Decimal @db.Decimal(12,2)

  transaction       Transaction    @relation(fields: [transactionId], references: [transactionId], onDelete: Cascade)
  variant           ProductVariant @relation(fields: [variantId], references: [variantId])

  @@map("transaction_items")
  @@schema("public")
}

model Payment {
  paymentId     String    @id @default(uuid()) @map("payment_id") @db.Uuid
  transactionId String    @map("transaction_id") @db.Uuid
  method        String    @db.VarChar(30)
  amount        Decimal   @db.Decimal(12,2)
  status        String    @default("pending") @db.VarChar(20)
  payload       Json?
  createdAt     DateTime? @default(now()) @map("created_at")

  transaction   Transaction @relation(fields: [transactionId], references: [transactionId], onDelete: Cascade)

  @@map("payments")
  @@schema("public")
}

model SiteSettings {
  id                   Int     @id @default(1)
  brandName            String? @map("brand_name")
  tagline              String?
  logoPath             String? @map("logo_path")
  heroBadge            String? @map("hero_badge")
  heroHeading          String? @map("hero_heading")
  heroHighlight        String? @map("hero_highlight")
  heroDescription      String? @map("hero_description")
  heroImagePath        String? @map("hero_image_path")
  promotionTitle       String? @map("promotion_title")
  promotionDescription String? @map("promotion_description")
  instagramUrl         String? @map("instagram_url")
  whatsappNumber       String? @map("whatsapp_number")
  contactEmail         String? @map("contact_email")
  footerText           String? @map("footer_text")

  @@map("site_settings")
  @@schema("public")
}
