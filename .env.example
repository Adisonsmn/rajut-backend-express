# Server
PORT=3000
NODE_ENV=development

# Database (Supabase PostgreSQL)
# Port 5432 = direct/session mode (digunakan untuk runtime dan introspect)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Session mode untuk prisma migrate & db pull
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min32chars
JWT_EXPIRES_IN=7d

# Supabase Storage
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxx

# S3 Settings
SUPABASE_PRODUCT_BUCKET=product-images
SUPABASE_CUSTOMPRODUCT_REQUEST_BUCKET=custom-product-request-images
SUPABASE_CUSTOMPRODUCT_RESPONSE_BUCKET=custom-product-response-images
SUPABASE_ACCOUNT_PROFILE_BUCKET=account-profile-images
SUPABASE_SITE_BUCKET=site-assets

# CORS — URL frontend (Vite default: 5173)
FRONTEND_URL=http://localhost:5173
